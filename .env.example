# Copy this file to .env and fill in your values. Never commit the real .env.

# --- Connection mode ---
# "ssh"    (default) hop over SSH to a bastion/DB host and run the remote
#          `mysql` CLI binary. SSH_* settings below only apply in this mode.
# "direct" connect straight to MySQL over TCP or a local unix socket using
#          a bundled Python driver (no SSH, no remote `mysql` CLI needed).
MYSQL_CONN_MODE=ssh

# --- SSH mode settings (used only when MYSQL_CONN_MODE=ssh) ---
SSH_HOST=user@dbhost.example.internal
# Optional bastion/jump host; leave empty when the bastion IS the DB host.
SSH_JUMP=user@bastion.example.com
# SSH_KEY=/Users/you/.ssh/id_ed25519

# --- MySQL credentials (used by both connection modes) ---
# Dedicated read-only diagnostics user (see README for the GRANT statements)
# -- never the application's own DB user.
MYSQL_USER=mcp_diag
MYSQL_PASSWORD=change-me

# --- MySQL target ---
# Preferred for SSH mode: the socket path as seen ON the DB host.
MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
# Used when MYSQL_SOCKET is unset. In direct mode, this is the host/port
# this machine connects to (through any local port-forward you've set up).
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# --- TLS (used only when MYSQL_CONN_MODE=direct) ---
# "disabled" (default), "required", "verify_ca", or "verify_identity".
MYSQL_SSL_MODE=disabled
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_CERT=/path/to/client-cert.pem
# MYSQL_SSL_KEY=/path/to/client-key.pem

# --- Timeouts & output limits ---
MYSQL_TIMEOUT_SEC=8
MYSQL_CONNECT_TIMEOUT_SEC=5
MYSQL_MAX_ROWS=200
INFO_TRUNCATE=512
INNODB_SECTION_TRUNCATE=8000

# --- Running as a shared network server (optional) ---
# Default is "stdio" (one local client). Set to "streamable-http" (or the
# legacy "sse") to serve multiple clients/agents over HTTP instead -- see
# the "Running as a shared network server" section of README.md.
MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Required for any non-stdio MCP_TRANSPORT: "token1:alice,token2:bob".
# Refuses to start without this (or MCP_ALLOW_NO_AUTH=true) once network
# mode is selected, so a shared server can't be exposed unauthenticated
# by accident.
# MCP_AUTH_TOKENS=
# MCP_ALLOW_NO_AUTH=false

# Required once MCP_HOST is not 127.0.0.1/localhost, to satisfy the MCP
# SDK's DNS-rebinding protection -- the hostname(s)/origin(s) clients will
# actually use to reach this server.
# MCP_ALLOWED_HOSTS=mysql-diag.internal.example.com
# MCP_ALLOWED_ORIGINS=https://mysql-diag.internal.example.com
