# SSH: hop through a bastion, then run mysql on the DB host.
# If the bastion IS the DB host, leave SSH_JUMP empty.

SSH_HOST=user@dbhost.example.internal
SSH_JUMP=user@bastion.example.com
# SSH_KEY=/Users/you/.ssh/id_ed25519

# MySQL as seen FROM the DB host (socket preferred).
MYSQL_USER=mcp_diag
MYSQL_PASSWORD=change-me
MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Caps
MYSQL_TIMEOUT_SEC=8
MYSQL_CONNECT_TIMEOUT_SEC=5
MYSQL_MAX_ROWS=200
INFO_TRUNCATE=512
INNODB_SECTION_TRUNCATE=8000
